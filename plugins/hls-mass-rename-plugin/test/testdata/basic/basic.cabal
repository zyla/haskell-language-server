cabal-version: 2.2

name:           basic
version:        0.1.0.0
author:         Test
maintainer:     test@example.com
license:        NONE
build-type:     Simple

library
  exposed-modules:
      Types1
      Types2
      Types3
      Types4
      Types5
      Types5Internal
      Use
      UseSelector
      UseWithConstructor
      UseWithOpenImport
      UseWithoutConstructor
      UsePartialImport
      UseMultipleConstructors
      UseReexport
      PrefixedFields
  hs-source-dirs:
      src
  default-extensions:
      OverloadedStrings
      DuplicateRecordFields
      OverloadedRecordDot
      NamedFieldPuns
      LambdaCase
      RecordWildCards
      DataKinds
  ghc-options: -Wall -Wno-unticked-promoted-constructors -Wno-name-shadowing
  build-depends:
      base >=4.7 && <5
    , text
    , template-haskell
  default-language: Haskell2010
